{
  "name": "@agenticdriver/provider-icons",
  "version": "0.1.0-alpha.3",
  "description": "Shared AI provider and product marks for web and native applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agenticdriver/provider-icons.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./svg": {
      "types": "./svg.d.ts",
      "default": "./svg.js"
    },
    "./manifest.json": "./manifest.json",
    "./assets/*": "./assets/*",
    "./dom": {
      "types": "./dom.d.ts",
      "default": "./dom.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    }
  },
  "files": [
    "assets",
    "manifest.json",
    "manifest.js",
    "index.js",
    "index.d.ts",
    "svg.js",
    "svg.d.ts",
    "licenses",
    "LICENSE",
    "NOTICE",
    "provenance.json",
    "sources",
    "scripts/vendor.py",
    "svg-data.js",
    "render.js",
    "dom.js",
    "dom.d.ts",
    "react.js",
    "react.d.ts",
    "react-runtime.js",
    "react-provider.js",
    "react-names.js",
    "react"
  ],
  "scripts": {
    "sync:lobehub": "python3 scripts/sync_lobehub.py",
    "build": "python3 scripts/build.py",
    "test": "python3 scripts/build.py --check && python3 -m unittest discover -s tests -p 'test_*.py' && node --test tests/*.test.mjs",
    "prepack": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18.3.1 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "jsdom": "30.1.1",
    "esbuild": "0.25.12"
  }
}
